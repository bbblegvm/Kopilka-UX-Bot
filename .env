# Токен от @BotFather
BOT_TOKEN=8896030171:AAF9IGwnPIPiwtt9bCLDkJR9An3v9Zr4jmE

# Часовой пояс и время ежедневного уведомления (ЧЧ:ММ)
TZ_NAME=Europe/Moscow
REMIND_TIME=15:20

# Сколько минут после REMIND_TIME бот ещё успеет отправить уведомление.
# Нужно, если бот запущен не круглосуточно: запустили в 13:30 — уведомление всё равно придёт.
# Если бот проспал всё окно, в этот день уведомления не будет.
REMIND_WINDOW_MIN=180

# Монет за пополнение (не чаще одного раза в день)
COINS_PER_TOPUP=50

CURRENCY=₽
DB_PATH=piggybank.db

# Telegram ID тех, кому доступны тестовые команды (/reset, /notify, /nextday, /givecoins).
# Свой ID можно узнать у бота командой /id. Несколько ID — через запятую.
ADMIN_IDS=
